# GraphGuard Configuration Template
# Copy this file to .env and adjust variables as needed

# FalkorDB Graph Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=graphguard

# LLM Provider Configuration ('openai' or 'gemini')
LLM_PROVIDER=openai

# OpenAI Model API Configuration (Optional)
# If left blank or GRAPHGUARD_DEMO_MODE=true, GraphGuard runs in deterministic demo mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Configuration (Optional)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Mode & Safety Controls
GRAPHGUARD_DEMO_MODE=true
MCP_SERVER_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_CALLS=8
GRAPH_MAX_HOPS=5
